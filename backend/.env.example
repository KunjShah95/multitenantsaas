# DealFlow360 — environment template (Phase 00)
# Copy to .env and fill real values locally. Do NOT commit .env.
# See docs/00-owner-setup.md and docs/02-technology-decisions.md for required contract.

# --- Runtime ---
NODE_ENV=development
PORT=4000

# --- Neon PostgreSQL (Phase 1+) ---
# Pooled connection used by the API at runtime
DATABASE_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/dbname?sslmode=require
# Direct/unpooled connection used only by migrations/CI (never by the web process)
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-example.region.aws.neon.tech/dbname?sslmode=require

# --- Auth secrets (generate with: openssl rand -base64 48 — run twice, keep distinct) ---
JWT_ACCESS_SECRET=change-me-generate-a-64-char-random-string
SESSION_PEPPER=change-me-generate-a-different-64-char-random-string

# --- Frontend origins (CORS) ---
APP_ORIGIN=http://localhost:5173
PORTAL_ORIGIN=http://localhost:5173

# --- Deferred providers — leave unset until their phase enables the adapter ---
# Phase 2: Email adapter (ConsoleEmailAdapter is used when unset)
# EMAIL_PROVIDER_API_KEY=
# EMAIL_FROM=

# Phase 9: Object storage for durable PDF/XLSX/CSV exports (R2/S3-compatible)
# OBJECT_STORAGE_ENDPOINT=
# OBJECT_STORAGE_BUCKET=
# OBJECT_STORAGE_ACCESS_KEY_ID=
# OBJECT_STORAGE_SECRET_ACCESS_KEY=
# OBJECT_STORAGE_REGION=auto

# Phase 8: Payment provider webhook verification (chosen provider in that phase)
# PAYMENT_PROVIDER=stripe
# PAYMENT_WEBHOOK_SECRET=

# Phase 10: Error tracking / observability (recommended before staging)
# ERROR_TRACKING_DSN=
